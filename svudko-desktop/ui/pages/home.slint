import {
    ListView,
    HorizontalBox,
    Button, 
} from "std-widgets.slint";
import { Logic, LocalDevices, Hostname } from "../logic.slint";
import { Theme } from "../theme.slint";
import { NoDataImg } from "../components/no_data.slint";
import { CenterLayout } from "../components/center_layout.slint";
import { IconBtn } from "../components/icon_button.slint";
import { Icons } from "../icons.slint";
import { Divider } from "../components/divider.slint";

export component Home inherits Rectangle {
    in-out property <[LocalDevices]> discovered_hosts <=> Logic.model.discovered-hosts;
    in-out property <[Hostname]> pairing_requests <=> Logic.model.pairing_requests;

    background: Theme.secondary-background;

    VerticalLayout {
        padding: Theme.padding;

        if discovered_hosts.length == 0: NoDataImg {
            text: "No hosts found";
        }

        ListView {
            for host[i] in discovered_hosts: CenterLayout {
                Divider {
                    width: 95%;
                }

                HorizontalLayout {
                    padding: Theme.padding;
                    Text {

                        text: host.hostname.name;
                        vertical-alignment: center;
                        color: Theme.primary-text-color;
                    }

                    if host.paired: IconBtn {
                        text: "Select Files";
                        text-color: Theme.secondary-text-color;

                        icon: Icons.directory-arrow-left;
                        border-color: Theme.dark-text-color;
                        border-radius: Theme.border-radius;

                        bg-color: Theme.thirdly-brand-color;

                        clicked => {
                            Logic.select_and_send_files(host.hostname)
                        }
                    }

                    if !host.paired: IconBtn {
                        text: "Pair";
                        text-color: Theme.secondary-text-color;

                        icon: Icons.placeholder;
                        border-color: Theme.dark-text-color;
                        border-radius: Theme.border-radius;

                        bg-color: Theme.thirdly-brand-color;

                        clicked => {
                            Logic.pair_request(host.hostname)
                        }
                    }
                }
            }
        }

        if pairing_requests.length != 0: Divider {
            width: 95%;
        }

        ListView {
            for request[i] in pairing_requests: CenterLayout {
                HorizontalLayout {
                    padding: Theme.padding;
                    Text {

                        text: request.name;
                        vertical-alignment: center;
                        color: Theme.primary-text-color;
                    }

                    IconBtn {
                        text: "Accept";
                        text-color: Theme.secondary-text-color;

                        icon: Icons.placeholder;
                        border-color: Theme.dark-text-color;
                        border-radius: Theme.border-radius;

                        bg-color: Theme.thirdly-brand-color;

                        clicked => {
                            Logic.pair_response(request, true)
                        }
                    }

                    IconBtn {
                        text: "Deny";
                        text-color: Theme.secondary-text-color;

                        icon: Icons.placeholder;
                        border-color: Theme.dark-text-color;
                        border-radius: Theme.border-radius;

                        bg-color: Theme.thirdly-brand-color;

                        clicked => {
                            Logic.pair_response(request, false)
                        }
                    }
                }
            }
        }
    }
}
